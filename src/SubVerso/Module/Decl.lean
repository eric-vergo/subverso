module
public import SubVerso.Module

public section

open Lean
open SubVerso.Highlighting

/-!
Looking up the source code of a declaration in a module's highlighted items.

A module's items are its commands, each with the names it marks as defined (`ModuleItem.defines`).
A declaration is found in one of three ways, tried in order:

 1. **By name**: the first item whose `defines` contains the name. This covers declarations that are
    named in the source, including those in namespaces and sections, every declaration of a `mutual`
    block (all map to the whole block), structure fields, explicitly named constructors and
    inductive constructors, and auxiliary definitions in `where` clauses. Private names are compared
    by their user-facing name, because the private prefix depends on how the module was elaborated.

 2. **By position**, when the caller supplies one: the item whose source range contains it. Names
    that do not appear in the source, such as anonymous instances (`instance : Add Point`) or
    instances generated by `deriving`, are found this way. Callers with an environment that contains
    the module can use the position recorded by Lean, e.g. the `range.pos` of
    `Lean.findDeclarationRanges?`.

 3. **By enclosing name**: the first item that defines the nearest proper prefix of the name.
    Auxiliary declarations whose names extend the declaration that produced them map to the command
    that produced them: `Point.mk`, `Point.rec` and `Point.casesOn` to the structure, equation lemmas
    such as `f.eq_1` to `f`.

Which names a command marks as defined depends on the Lean version that elaborated the module (before
Lean 4.8, many definition sites in namespaces and sections are not marked), so callers that have the
declaration's position should pass it.

The lookups assume that the module is the one that declares the name: a declaration from another
module whose name extends a name defined here is attributed to the item that defines the prefix (the
result's `owner?` says so), and positions must be positions in this module's source.
-/

namespace SubVerso.Module

/-- The source code of a declaration, found by `Module.findDecl?`. -/
structure DeclSource where
  /-- The name that was looked up. -/
  name : Name
  /--
  The index of the defining command in `Module.items`. Several declarations may share one command
  (structures, inductive types, `mutual` blocks, `where` clauses).
  -/
  index : Nat
  /--
  The name in the command's `defines` that was matched: `name` itself (up to privacy) for a direct
  match, the nearest defined prefix of `name` for auxiliary declarations such as `Point.mk`, and
  `none` when the command was found by source position.
  -/
  owner? : Option Name
  /--
  The syntax kind of the defining command, without any outer `in`; for example
  `Lean.Parser.Command.declaration` or `Lean.Parser.Command.mutual`.
  -/
  kind : SyntaxNodeKind
  /-- The source range of the defining command. -/
  range : Option (Lean.Position × Lean.Position)
  /-- All names that the defining command marks as defined. -/
  defines : Array Name
  /-- The highlighted code of the defining command, including hovers and proof states. -/
  code : Highlighted
deriving Inhabited

/-- The user-facing form of a name: private names are compared without their private prefix. -/
private def userName (n : Name) : Name := (privateToUserName? n).getD n

/-- Is `p` at or before `q`? -/
private def posLe (p q : Lean.Position) : Bool :=
  p.line < q.line || (p.line == q.line && p.column ≤ q.column)

/-- Checks whether the item's source range contains `pos`. Items without a range contain nothing. -/
def ModuleItem.contains (item : ModuleItem) (pos : Lean.Position) : Bool :=
  match item.range with
  | some (s, e) => posLe s pos && posLe pos e
  | none => false

/--
Finds the index of the first item whose `defines` contains `n`. Private names are compared by their
user-facing name.
-/
def Module.definingItem? (mod : Module) (n : Name) : Option Nat :=
  let n := userName n
  mod.items.findIdx? fun item => item.defines.any (userName · == n)

/-- Finds the index of the item whose source range contains `pos`. -/
def Module.itemAt? (mod : Module) (pos : Lean.Position) : Option Nat :=
  mod.items.findIdx? (·.contains pos)

/-- Packages the item at `index` as the source of the declaration `name`. -/
def Module.declSourceAt (mod : Module) (name : Name) (index : Nat) (owner? : Option Name) :
    DeclSource :=
  let item := mod.items[index]!
  { name, index, owner?, kind := item.kind, range := item.range, defines := item.defines,
    code := item.code }

/--
Finds the command that defines the declaration `n` in the module, returning its highlighted code
together with its index, range and kind.

The name is looked up in the items' `defines` first; failing that, `pos?` (a position in this
module's source, such as the declaration's position as recorded by Lean) selects the item that
contains it; failing that, the item that defines the nearest enclosing name of `n` is used. See the
module documentation for the cases each step covers.
-/
def Module.findDecl? (mod : Module) (n : Name) (pos? : Option Lean.Position := none) :
    Option DeclSource :=
  if let some i := mod.definingItem? n then
    some (mod.declSourceAt n i (some n))
  else if let some i := pos?.bind mod.itemAt? then
    some (mod.declSourceAt n i none)
  else
    viaPrefix n (userName n).getPrefix
where
  /-- Tries the prefixes of `n`, longest first. -/
  viaPrefix (n : Name) : Name → Option DeclSource
    | .anonymous => none
    | p@(.str q _) | p@(.num q _) =>
      if let some i := mod.definingItem? p then some (mod.declSourceAt n i (some p))
      else viaPrefix n q

end SubVerso.Module
